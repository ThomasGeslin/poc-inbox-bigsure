{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=apps/api"
  },
  "deploy": {
    "startCommand": "npm run start:prod --workspace=apps/api",
    "healthcheckPath": "/api",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
