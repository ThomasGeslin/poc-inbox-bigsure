# Database (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# App
PORT=3000
APP_PUBLIC_URL="https://your-ngrok-or-domain.example.com"

# Twilio
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SMS sender number (E.164 format)
TWILIO_SMS_NUMBER="+33XXXXXXXXX"
# WhatsApp sender number — Twilio adds the "whatsapp:" prefix automatically if missing
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Base URL exposed to Twilio for webhook signature validation (ngrok or production domain)
TWILIO_WEBHOOK_BASE_URL="https://xxxx.ngrok-free.app"
