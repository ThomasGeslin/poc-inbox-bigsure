# Database (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# App
PORT=3000
APP_PUBLIC_URL="https://your-ngrok-or-domain.example.com"

# Twilio
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_WEBHOOK_BASE_URL="https://your-ngrok-or-domain.example.com"
# SMS sender number (E.164 format)
TWILIO_SMS_NUMBER="+33XXXXXXXXX"
# WhatsApp sender number — Twilio adds the "whatsapp:" prefix automatically if missing
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Voice — can be the same number as SMS if it supports both Voice + SMS
TWILIO_VOICE_NUMBER="+33XXXXXXXXX"
# Real phone number to forward inbound calls to (E.164 format)
TWILIO_FORWARD_NUMBER="+33XXXXXXXXX"

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=contact@tondomaine.com
RESEND_INBOUND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Cloudmailin — adresse à communiquer aux contacts pour recevoir leurs emails
# Webhook à configurer dans Cloudmailin → Target URL : https://ton-domaine.com/api/webhooks/mail/inbound
CLOUDMAILIN_ADDRESS=xxxxxxxx@cloudmailin.net
